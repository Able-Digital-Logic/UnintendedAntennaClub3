	(text "We need to preallocate files; large aligned writes; log gaps and card removal explicitly.\nStarts at 250 / 500 kpair/s. 1 Mpair/s could work theoretically but we need to measure card latency and analog settling.\nThe card must be safely stopped before removal. No guaranteed power-loss protection in an ordinary microSD card."
		(exclude_from_sim no)
		(at 172.72 279.654 0)
		(effects
			(font
				(size 1.2 1.2)
			)
		)
		(uuid "23b68f8f-cdbc-49b8-b396-72ba1ff3905a")
	)
	(text "8 MiB PSRAM / QUADSPI BANK 1\nManaged FIFO, not a writable memory-mapped heap.\n40 MHz initial clock; <=128-byte transactions.\nCE# low <8 us, high >=18 ns at <=85 C.\nReserve 6 MiB for spool; validate actual CE timing\nand cache / DMA ownership under display + SD load."
		(exclude_from_sim no)
		(at 311.658 88.138 0)
		(effects
			(font
				(size 1.3 1.3)
			)
		)
		(uuid "4bbd4e60-a4df-4c9f-94a2-0104c6af6386")
	)
	(text "NATIVE 4-BIT SDMMC / BURST WRITE BUFFER"
		(exclude_from_sim no)
		(at 205 18 0)
		(effects
			(font
				(size 2 2)
			)
		)
		(uuid "b28d5763-0b89-42cf-beb9-c0c6c516621a")
	)
	(text "47 k pull-ups on DAT0..3 and CMD; no clock pull-up.\n33 ohm series values are starting points for signal-integrity tuning."
		(exclude_from_sim no)
		(at 173.736 177.8 0)
		(effects
			(font
				(size 1.2 1.2)
			)
		)
		(uuid "d56bd3d9-e9fd-4ff1-8ef2-25e8d034183e")
	)
	(text "Connector ESD: short shunt return to ground plane.\nESD rating of diode does not establish enclosure-level compliance, need to find better diodes."
		(exclude_from_sim no)
		(at 58.564 280.818 0)
		(effects
			(font
				(size 1.2 1.2)
			)
		)
