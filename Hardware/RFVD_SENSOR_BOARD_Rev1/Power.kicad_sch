	)
	(text "BATTERY/POWER\n"
		(exclude_from_sim no)
		(at 136.398 14.986 0)
		(effects
			(font
				(size 1.5 1.5)
			)
		)
		(uuid "2bb4c1dc-3ae9-48d9-95b7-355ee73c01f0")
	)
	(text "ASSEMBLY / POWER NOTES\nF1: reflow only; no hand or wave soldering.\nU5 MB5: adjustable 3.322 V; 1 MHz FPWM; no spread spectrum.\nC19 470 nF: about 2.5 uVrms typical LDO noise.\nL1: marked start lead to SW; magnetic core not MR qualified."
		(exclude_from_sim no)
		(at 12.192 198.882 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5858ae83-a41e-4a3d-b673-2bb797f08fff")
	)
	(text "3.3 V BUCK / ANALOG FILTER"
		(exclude_from_sim no)
		(at 102.108 111.76 0)
		(effects
			(font
				(size 1.52 1.52)
			)
		)
		(uuid "78ed7995-a75d-4195-aa5e-6cd160f5e417")
	)
	(text "FB = 1 V; 33.2k / 14.3k divider\nVOUT = 3.32168 V nominal (TI Table 9-6).\n22 pF across upper resistor; do not short FB to output.\nL1 Isat = 4.8 A at 20% L drop (25 C)"
		(exclude_from_sim no)
		(at 139.954 161.544 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9f5857b0-cc07-4831-8168-0dbba7533a5c")
	)
	(text "+5 V ANALOG LDO"
		(exclude_from_sim no)
		(at 174.244 45.974 0)
		(effects
			(font
				(size 1.52 1.52)
			)
		)
		(uuid "b4f906c1-3f89-42d2-a942-d1b520bdc2e1")
	)
