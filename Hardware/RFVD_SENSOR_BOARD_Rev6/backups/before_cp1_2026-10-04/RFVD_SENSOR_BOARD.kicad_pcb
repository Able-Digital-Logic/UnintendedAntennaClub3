		(property "Function" "Generates about 3.32 V for the digital rail. fsw synchronized to BUCK_SYNC (U8 PB1 TIM1_CH3N, fsw = ADC fs = 833.33 kHz, so every buck harmonic aliases to DC); forced PWM via R900 when unsynchronized. Keep the VIN/GND hot loop (C32 0402) tight and the SW node small, >= 10 mm from FB1/Y1/U5."
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "2d2873e9-d180-4161-9230-88ff688ac0ae")
			(effects
