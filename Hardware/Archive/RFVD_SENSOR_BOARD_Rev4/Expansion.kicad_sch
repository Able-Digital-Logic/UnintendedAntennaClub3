  (label "EXP_INT1_N"
    (at 148.59 170.18 0)
    (fields_autoplaced yes)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "a0f307e2-c684-49c7-9658-f201f6666ce5")
  )
  (text "RFVD-EXP v1.1 design values (2026-10-04)\nU402 TPS259631 (TI SLVSET8A):\n ILIM Eq.5 RILM = 903/(ILIM - 0.0112)\n   R410 1.50k -> 0.613 A (DDS shield 2.14 W)\n OVLO Eq.2 VOV = 1.2 V x (R408+R409)/R409\n   470k/64.9k -> 9.89 V (9.43-10.28 V wc)\n dVdt Eq.4 CdVdt = 42000 pF / SR\n   47 nF -> 0.89 V/ms, 51 mA into 57 uF\nU401 TPS2553 (TI SLVS841F Eq.1):\n   R401 45.3k -> IOS 524 / 577 / 638 mA\nJ11 on B.Cu (mirrored), 5.0 mm stack,\n pin 36 reserved NC, SH pads = GND"
    (at 110.49 176.276 0)
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid "6eda9301-b967-4136-acb0-20b9aadfcfa8")
  )
